#  Clerk Authentication 
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_...

# ═══════════════════════════════════════════════
#  Clerk OAuth / Social Sign-In
# ═══════════════════════════════════════════════
#
# For development mode, Clerk uses shared credentials — no .env values needed.
# Just enable Google, Apple, and Microsoft in your Clerk Dashboard:
#   1. Go to Clerk Dashboard → SSO Connections
#   2. Add connection → select Google, Apple, and Microsoft
#   3. Toggle "Enable for sign-up and sign-in"
#   4. For production, you'll need custom credentials for each provider.
#
# Google OAuth (only needed for production / native sign-in with Google):
# EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_CLERK_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_CLERK_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=

#  Logo.dev (service icons) 
# Get your free token at https://logo.dev
EXPO_PUBLIC_LOGO_DEV_TOKEN=...

#  Supabase (free tier) 
# Get these from Project Settings → API in Supabase dashboard
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
