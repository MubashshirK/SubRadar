{
  "expo": {
    "name": "SubRadar",
    "slug": "SubRadar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "scheme": "subradar",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.mubashshir.subradar",
      "supportsTablet": true
    },
    "android": {
      "package": "com.mubashshir.subradar",
      "adaptiveIcon": {
        "backgroundColor": "#0f0f12",
        "foregroundImage": "./assets/app-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0f0f12",
          "dark": {
            "backgroundColor": "#0f0f12"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlusJakartaSans-Regular.tff",
            "./assets/fonts/PlusJakartaSans-Bold.tff",
            "./assets/fonts/PlusJakartaSans-Medium.tff",
            "./assets/fonts/PlusJakartaSans-SemiBold.tff",
            "./assets/fonts/PlusJakartaSans-ExtraBold.tff",
            "./assets/fonts/PlusJakartaSans-Light.tff"
          ]
        }
      ],
      "@clerk/expo",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}